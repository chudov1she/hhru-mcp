# ID приложения hh.ru (https://dev.hh.ru)
HH_CLIENT_ID=your_client_id

# Секрет приложения hh.ru
HH_CLIENT_SECRET=your_client_secret

# Redirect URI (должен совпадать с указанным в приложении hh.ru)
HH_REDIRECT_URI=http://localhost:8000/callback

# Фиксированный ключ доступа к MCP/REST API (Authorization: Bearer <ключ>)
MCP_API_KEY=change_me_generate_random_string